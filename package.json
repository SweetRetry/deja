{
  "name": "deja",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:slow": "DEJA_E2E_SLOW=1 playwright test",
    "tauri": "tauri",
    "install:app": "sh scripts/install-app.sh",
    "e2e:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin deja-e2e --features e2e",
    "e2e:api": "DEJA_DATA_DIR=.e2e-data src-tauri/target/debug/deja-e2e",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fixtures": "node scripts/make-fixtures.mjs",
    "demo": "node scripts/make-demo.mjs",
    "shots": "npm run demo && SHOTS_DIR=.shots DEJA_SHOTS_VAULT=demo/素材库 playwright test e2e/shots.spec.ts",
    "readme": "node scripts/make-readme-images.mjs",
    "media": "npm run shots && npm run readme && npm run promo",
    "promo": "node scripts/make-promo.mjs",
    "mg": "node scripts/make-mg-music.mjs && PROMO_AUDIO=.cache/mg-music.wav PROMO_PAGE=promo/mg.html PROMO_OUT=docs/mg.mp4 PROMO_LOOP=docs/mg.gif PROMO_LOOP_FROM=10.4 PROMO_LOOP_SECONDS=6 node scripts/make-promo.mjs",
    "icons": "node scripts/make-icons.mjs",
    "hooks": "git config core.hooksPath .githooks || true",
    "prepare": "npm run hooks",
    "test:unit": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "motion": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "2.0.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
