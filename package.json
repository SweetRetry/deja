{
  "name": "eagle-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e": "npm run e2e:build && playwright test",
    "tauri": "tauri",
    "e2e:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin shelf-e2e",
    "e2e:api": "SHELF_DATA_DIR=.e2e-data src-tauri/target/debug/shelf-e2e",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fixtures": "node scripts/make-fixtures.mjs",
    "hooks": "git config core.hooksPath .githooks || true",
    "prepare": "npm run hooks",
    "test:unit": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "motion": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "2.0.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
